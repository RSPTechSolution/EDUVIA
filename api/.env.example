APP_NAME=EDUVIA
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://eduvia_app:eduvia_app_dev@localhost:5433/eduvia
MIGRATION_DATABASE_URL=postgresql+asyncpg://eduvia:eduvia_owner_dev@localhost:5433/eduvia
REDIS_URL=redis://localhost:6380/0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:8090
APP_URL=http://localhost:3000
# Public form limits per IP per hour (keep the defaults, 5 and 10, in production)
SIGNUP_RATE_LIMIT=100
CONTACT_RATE_LIMIT=100

# Online fee payments: test (simulated, development only) | none
PAYMENT_GATEWAY=test

# Email: console (log only) | brevo. A Brevo SMTP key (xsmtpsib-) also needs BREVO_SMTP_LOGIN;
# an API key (xkeysib-) doesn't. EMAIL_FROM must be a sender verified in Brevo.
EMAIL_PROVIDER=console
BREVO_API_KEY=
BREVO_SMTP_LOGIN=
EMAIL_FROM=no-reply@yourdomain.in
EMAIL_FROM_NAME=EDUVIA
